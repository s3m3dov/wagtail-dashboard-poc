# IDE (VScode & JetBrains)
.idea/
.vscode/

# Log files
*.log
log/
logs/

# Package files
*.jar

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Env
venv/
env/
venv*/
env*/
*old
*env
virtualenv.bat

# Unit test reports
TEST*.xml

# Compiled Python bytecode
*.py[cod]
*.pyc

# Python Cache
__pycache__/
**/__pycache__/

# Node artifact files
node_modules/
dist/

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Compiled Java class files
*.class

# Maven
target/
dist/

# Database
*.sqlite3

# Celery
celerybeat-schedule
*.bak
*.dat
*.dir
*.pid

# Django Dev
local_settings.py
staticfiles/
prj_ga_chartjs/settings/local.py
